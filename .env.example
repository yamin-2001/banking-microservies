# ---------------------------------------------------------------------------
# Banking platform - local environment
#
# Copy this file to `.env` in the repository root and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and MUST never be committed.
#
# The values below are safe development placeholders. Generate real ones with:
#
#     openssl rand -base64 32      # EVENT_CRYPTO_KEY  (must decode to exactly 32 bytes)
#     openssl rand -hex 32         # OTP_HASH_SECRET
#     openssl rand -hex 32         # JWT_SECRET       (must be identical in gateway and user-service)
# ---------------------------------------------------------------------------

# --- PostgreSQL (docker-compose.yml) --------------------------------------
# Used by the `postgres` container. The same value is what the services read
# as DB_PASSWORD, so keep them identical.
POSTGRES_PASSWORD=change-me-postgres

# --- Redis (docker-compose.yml) -------------------------------------------
# Used by the `redis` container and by the services as REDIS_PASSWORD.
REDIS_PASSWORD=change-me-redis

# --- Kafka ----------------------------------------------------------------
# Only change this if you run the broker somewhere other than localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Service discovery ----------------------------------------------------
# Only change this if you run Eureka somewhere other than localhost:8761.
EUREKA_URL=http://localhost:8761/eureka

# --- PostgreSQL, as the services see it -----------------------------------
# The services connect to the container through this mapped port.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=banking_admin
DB_PASSWORD=change-me-postgres

# --- Redis, as the services see it ----------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- JWT ------------------------------------------------------------------
# Signing key for the bearer tokens. It MUST be at least 32 characters and
# MUST be byte-for-byte identical in `api-gateway` and `user-service`,
# otherwise the gateway rejects every token the user-service issues.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long

# --- Event encryption -----------------------------------------------------
# AES-256-GCM key used to encrypt OTP codes and e-mail verification tokens on
# the event bus. Must decode to exactly 32 bytes and MUST be identical in
# `otp-service`, `notification-service` and `user-service`.
# Generate with: openssl rand -base64 32
EVENT_CRYPTO_KEY=REPLACE_WITH_BASE64_32_BYTES_FROM_OPENSSL_RAND_BASE64_32

# --- OTP hashing ----------------------------------------------------------
# HMAC-SHA256 key used to hash OTP codes before they are stored in Redis.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET=change-me-otp-hash-secret

# --- E-mail (notification-service) ----------------------------------------
# Gmail address and Google *app password* (not your account password).
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# --- Monitoring stack (event-bus-service/docker-compose.monitoring.yml) ---
# Password for the Grafana admin user.
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Development helpers --------------------------------------------------
# Every new account opens with this balance so transfers can be tested without
# a funding step. Set to 0 for anything real.
ACCOUNT_DEMO_BALANCE=0.00

# Where the JSON log files are written. Alloy reads this directory.
BANKING_LOG_DIR=${HOME}/banking-logs
